# Локальная разработка (docker-compose)
DATABASE_URL=postgresql://gymbro:gymbro@localhost:5432/gymbro_stats
DATABASE_SSL_MODE=

# Render Postgres — см. Render Dashboard → Database → Connections
# Для Web Service на Render используй Internal Database URL.
# Для подключения с локального компьютера — External Database URL + sslmode.
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-XXXX-a.REGION-postgres.render.com:5432/gymbro_stats
# DATABASE_SSL_MODE=require

JWT_SECRET=change-me
JWT_ALGORITHM=HS256

NINJAS_API_KEY=

AI_SERVICE_URL=https://gymbro-ai-service.onrender.com
TELEGRAM_SERVICE_URL=http://localhost:8002
